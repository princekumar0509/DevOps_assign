#CWD ~/Downloads/Devops-Assignments-main/session-15-helm/01-helm-commands
$ sed -i "s/^appVersion: .*/appVersion: \"1.27-alpine\"/; s/^description: .*/description: Demo web app chart for the Session 15 Helm command practice/" webapp/Chart.yaml && grep -E "^(name|description|version|appVersion):" webapp/Chart.yaml
name: webapp
description: Demo web app chart for the Session 15 Helm command practice
version: 0.1.0
appVersion: "1.27-alpine"

$ helm install webapp ./webapp --namespace session15 --create-namespace --wait --timeout 120s
NAME: webapp
LAST DEPLOYED: Wed Oct  7 23:30:23 2026
NAMESPACE: session15
STATUS: deployed
REVISION: 1
DESCRIPTION: Install complete
NOTES:
1. Get the application URL by running these commands:
  export POD_NAME=$(kubectl get pods --namespace session15 -l "app.kubernetes.io/name=webapp,app.kubernetes.io/instance=webapp" -o jsonpath="{.items[0].metadata.name}")
  export CONTAINER_PORT=$(kubectl get pod --namespace session15 $POD_NAME -o jsonpath="{.spec.containers[0].ports[0].containerPort}")
  echo "Visit http://127.0.0.1:8080 to use your application"
  kubectl --namespace session15 port-forward $POD_NAME 8080:$CONTAINER_PORT


#CWD ~/Downloads/Devops-Assignments-main/session-14-kubernetes-troubleshooting/02-common-issues/07-pod-networking
$ cat allow-client-networkpolicy.yaml | grep -v "^#"
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-client-to-ledger
  namespace: session14
spec:
  podSelector:
    matchLabels:
      app: ledger
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector:
            matchLabels:
              role: client
      ports:
        - protocol: TCP
          port: 8000

$ kubectl apply -f allow-client-networkpolicy.yaml
networkpolicy.networking.k8s.io/allow-client-to-ledger created

$ kubectl get pods -n session14 client intruder --show-labels
NAME       READY   STATUS    RESTARTS   AGE     LABELS
client     1/1     Running   0          4m32s   role=client
intruder   1/1     Running   0          4m31s   role=untrusted

$ kubectl exec -n session14 client -- wget -qO /dev/null -S -T 3 http://ledger-svc 2>&1 | grep HTTP/
  HTTP/1.0 200 OK
  Server: SimpleHTTP/0.6 Python/3.12.15

$ kubectl exec -n session14 intruder -- wget -qO- -T 3 http://ledger-svc
wget: download timed out
command terminated with exit code 1

$ kubectl delete networkpolicy default-deny-ingress allow-client-to-ledger -n session14
networkpolicy.networking.k8s.io "default-deny-ingress" deleted from session14 namespace
networkpolicy.networking.k8s.io "allow-client-to-ledger" deleted from session14 namespace


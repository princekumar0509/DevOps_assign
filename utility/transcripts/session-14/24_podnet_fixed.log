#CWD ~/Downloads/Devops-Assignments-main/session-14-kubernetes-troubleshooting/02-common-issues/07-pod-networking
$ diff broken.yaml fixed.yaml
1,2d0
< # BUG: the app binds to 127.0.0.1, so it only accepts connections from inside
< # its own network namespace - other Pods (and the Service) are refused.
21c19
<           command: ["python3", "-m", "http.server", "8000", "--bind", "127.0.0.1"]
---
>           command: ["python3", "-m", "http.server", "8000", "--bind", "0.0.0.0"]   # FIX
24,35c22,25
< ---
< apiVersion: v1
< kind: Service
< metadata:
<   name: ledger-svc
<   namespace: session14
< spec:
<   selector:
<     app: ledger
<   ports:
<     - port: 80
<       targetPort: 8000
---
>           readinessProbe:            # also added: the kubelet probes the Pod IP,
>             tcpSocket:               # so a 127.0.0.1-only bind would now show as 0/1
>               port: 8000
>             periodSeconds: 3

